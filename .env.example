# Copy to .env (gitignored) for scripts/release.sh. Both are optional:
# without LAKI_SIGN_ID the first "Developer ID Application" certificate in the Keychain signs;
# without APPLE_KEYCHAIN_PROFILE the notary profile is laki-notary (docs/manual-release.md › Once).
LAKI_SIGN_ID="Your Name (TEAMID1234)"
APPLE_KEYCHAIN_PROFILE=laki-notary
