{
  "name": "laki",
  "productName": "Laki",
  "version": "0.1.0",
  "description": "Workbench for coding agents in parallel git worktrees",
  "license": "MIT",
  "author": "Igor Kasyanchuk",
  "type": "module",
  "main": "out/main/index.js",
  "bin": {
    "laki": "bin/laki.js"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --no-warnings --test --test-concurrency=4 test/*.test.ts",
    "pack": "electron-vite build && electron-builder --dir",
    "daemon": "node --experimental-strip-types --no-warnings src/daemon/main.ts",
    "dev:web": "vite src/renderer --port 5199 --strictPort --host 127.0.0.1",
    "demo": "node --experimental-strip-types --no-warnings scripts/demo.ts"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.15",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "build": {
    "appId": "dev.laki.app",
    "productName": "Laki",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": false,
    "protocols": [{ "name": "Laki", "schemes": ["laki"] }],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": "dir",
      "category": "public.app-category.developer-tools",
      "identity": null
    }
  }
}
