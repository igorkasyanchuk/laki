{
  "name": "laki",
  "productName": "Laki",
  "version": "0.37.0",
  "description": "Workbench for coding agents in parallel git worktrees",
  "license": "MIT",
  "author": "Igor Kasyanchuk",
  "homepage": "https://laki.sh",
  "repository": "github:igorkasyanchuk/laki",
  "bugs": "https://github.com/igorkasyanchuk/laki/issues",
  "type": "module",
  "main": "out/main/index.js",
  "bin": {
    "laki": "bin/laki.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --no-warnings --test --test-concurrency=4 test/*.test.ts",
    "test:one": "f() { case \" $* \" in *.ts\\ *) node --experimental-strip-types --no-warnings --test \"$@\";; *) echo 'which files? npm run test:one -- test/pr.test.ts' >&2; exit 1;; esac; }; f",
    "pack": "electron-vite build && electron-builder --dir --publish never",
    "dmg": "npm version minor --no-git-tag-version && node --experimental-strip-types --no-warnings scripts/notes.ts && electron-vite build && electron-builder --mac dmg --publish never -c.directories.output=dist/release",
    "pack:x64": "npm i --no-save --force @lydell/node-pty-darwin-x64@$(node -p \"require('./node_modules/@lydell/node-pty/package.json').version\") && electron-vite build && electron-builder --dir --x64 --publish never",
    "pack:linux": "bash scripts/linux.sh",
    "release": "bash scripts/release.sh",
    "daemon": "node --experimental-strip-types --no-warnings src/daemon/main.ts",
    "dev:web": "vite src/renderer --port 5199 --strictPort --host 127.0.0.1",
    "demo": "node --experimental-strip-types --no-warnings scripts/demo.ts"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.15",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@blocknote/core": "^0.56.0",
    "@blocknote/mantine": "^0.56.0",
    "@blocknote/react": "^0.56.0",
    "@mantine/core": "^9.7.3",
    "@mantine/hooks": "^9.7.3",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.12.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "html-to-image": "^1.11.13",
    "mermaid": "^12.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "dev.laki.app",
    "productName": "Laki",
    "files": [
      "out/**/*",
      "widgets/**/*",
      "workflows/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_LICENSES.md",
      "src/renderer/src/fonts/*.{md,txt}"
    ],
    "asar": false,
    "electronFuses": {
      "runAsNode": true,
      "enableCookieEncryption": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false
    },
    "protocols": [
      {
        "name": "Laki",
        "schemes": [
          "laki"
        ]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "igorkasyanchuk",
      "repo": "laki-releases"
    },
    "mac": {
      "target": "dir",
      "category": "public.app-category.developer-tools",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "minimumSystemVersion": "13.0",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Laki listens while you dictate a prompt: the mic in a prompt box, or holding Fn (Settings › Voice).",
        "ElectronSquirrelPreventDowngrades": true
      }
    },
    "linux": {
      "target": "AppImage",
      "category": "Development",
      "executableName": "laki",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "toolsets": {
      "appimage": "1.0.3"
    }
  }
}
