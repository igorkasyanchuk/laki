{
  "name": "laki",
  "productName": "Laki",
  "version": "0.67.0",
  "description": "Workbench for coding agents in parallel git worktrees",
  "license": "MIT",
  "author": "Igor Kasyanchuk",
  "homepage": "https://laki.sh",
  "repository": "github:igorkasyanchuk/laki",
  "bugs": "https://github.com/igorkasyanchuk/laki/issues",
  "type": "module",
  "main": "out/main/index.js",
  "bin": {
    "laki": "bin/laki.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "npm run typecheck && npm run test:fast",
    "pretest": "electron-vite build -l warn",
    "pretest:one": "electron-vite build -l warn",
    "pretest:changed": "electron-vite build -l warn",
    "test": "node --experimental-strip-types --no-warnings scripts/test-run.ts",
    "test:report": "node --experimental-strip-types --no-warnings scripts/test-report.ts",
    "test:ui": "node --experimental-strip-types --no-warnings scripts/ui-smoke.ts",
    "test:sheet": "node --experimental-strip-types --no-warnings scripts/ui-sheet.ts",
    "test:cov": "node --experimental-strip-types --no-warnings scripts/cov.ts",
    "debt": "node --experimental-strip-types --no-warnings scripts/debt.ts",
    "prices": "node --experimental-strip-types --no-warnings scripts/prices.ts",
    "size": "node --experimental-strip-types --no-warnings scripts/size.ts",
    "mem": "node --experimental-strip-types --no-warnings scripts/mem.ts",
    "audit:deps": "node --experimental-strip-types --no-warnings scripts/audit.ts",
    "test:changed": "node --experimental-strip-types --no-warnings scripts/test-changed.ts",
    "eval:ai": "node --experimental-strip-types --no-warnings scripts/ai-evals.ts",
    "test:fast": "node --experimental-strip-types --no-warnings --test $(grep -L 'fresh(' test/*.test.ts)",
    "test:release": "node --experimental-strip-types --no-warnings scripts/test-rerun.ts",
    "test:one": "f() { case \" $* \" in *.ts\\ *) node --experimental-strip-types --no-warnings --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./scripts/test-history.ts --test-reporter-destination=stdout \"$@\";; *) echo 'which files? npm run test:one -- test/pr.test.ts' >&2; exit 1;; esac; }; f",
    "pack": "electron-vite build && electron-builder --dir --publish never",
    "dmg": "bash scripts/dmg.sh",
    "pack:x64": "node --experimental-strip-types --no-warnings scripts/x64-pty.ts && electron-vite build && electron-builder --dir --x64 --publish never",
    "pack:linux": "bash scripts/linux.sh",
    "release": "bash scripts/release.sh",
    "daemon": "node --experimental-strip-types --no-warnings src/daemon/main.ts",
    "dev:web": "vite src/renderer --port 5199 --strictPort --host 127.0.0.1",
    "demo": "node --experimental-strip-types --no-warnings scripts/demo.ts"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.18",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "ws": "^8.22.1"
  },
  "optionalDependencies": {
    "@lydell/node-pty-darwin-x64": "1.2.0-beta.18"
  },
  "devDependencies": {
    "@blocknote/core": "^0.57.0",
    "@blocknote/mantine": "^0.57.0",
    "@blocknote/react": "^0.57.0",
    "@mantine/core": "^9.7.5",
    "@mantine/hooks": "^9.7.5",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.12.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "html-to-image": "^1.11.13",
    "mermaid": "^12.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "overrides": {
    "minimatch@>=7 <11.0.1": "^11.0.1"
  },
  "build": {
    "appId": "dev.laki.app",
    "productName": "Laki",
    "files": [
      "out/**/*",
      "workflows/**/*",
      "docs/guide.md",
      "docs/features.md",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_LICENSES.md",
      "src/renderer/src/fonts/*.{md,txt}"
    ],
    "asar": false,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false
    },
    "protocols": [
      {
        "name": "Laki",
        "schemes": [
          "laki"
        ]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "igorkasyanchuk",
      "repo": "laki-releases"
    },
    "afterPack": "scripts/after-pack.cjs",
    "mac": {
      "target": "dir",
      "category": "public.app-category.developer-tools",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "minimumSystemVersion": "13.0",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Laki listens only while you dictate a prompt: the mic in a prompt box, holding Fn, or the talk key's pill (Settings › Voice).",
        "NSSpeechRecognitionUsageDescription": "Laki writes down what you say to the talk key on this Mac (Settings › Voice › Talk key: On this Mac); nothing leaves it.",
        "ElectronSquirrelPreventDowngrades": true,
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Folder",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.folder"
            ]
          }
        ]
      }
    },
    "linux": {
      "target": "AppImage",
      "category": "Development",
      "executableName": "laki",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "toolsets": {
      "appimage": "1.0.3"
    }
  },
  "lakiSize": {
    "js": 603,
    "css": 370
  },
  "lakiMem": {
    "daemon": 114,
    "renderer": 197,
    "ptyhost": 66
  }
}
