{
  "name": "laki",
  "productName": "Laki",
  "version": "0.13.0",
  "description": "Workbench for coding agents in parallel git worktrees",
  "license": "MIT",
  "author": "Igor Kasyanchuk",
  "type": "module",
  "main": "out/main/index.js",
  "bin": {
    "laki": "bin/laki.js"
  },
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --no-warnings --test --test-concurrency=4 test/*.test.ts",
    "pack": "electron-vite build && electron-builder --dir",
    "dmg": "npm version minor --no-git-tag-version && node --experimental-strip-types --no-warnings scripts/notes.ts && electron-vite build && electron-builder --mac dmg -c.directories.output=dist/release",
    "pack:x64": "npm i --no-save --force @lydell/node-pty-darwin-x64@$(node -p \"require('./node_modules/@lydell/node-pty/package.json').version\") && electron-vite build && electron-builder --dir --x64",
    "pack:linux": "bash scripts/linux.sh",
    "daemon": "node --experimental-strip-types --no-warnings src/daemon/main.ts",
    "dev:web": "vite src/renderer --port 5199 --strictPort --host 127.0.0.1",
    "demo": "node --experimental-strip-types --no-warnings scripts/demo.ts"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.15",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@blocknote/core": "^0.55.0",
    "@blocknote/mantine": "^0.55.0",
    "@blocknote/react": "^0.55.0",
    "@mantine/core": "^9.7.2",
    "@mantine/hooks": "^9.7.2",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.12.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "html-to-image": "^1.11.13",
    "mermaid": "^11.17.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "build": {
    "appId": "dev.laki.app",
    "productName": "Laki",
    "files": [
      "out/**/*",
      "widgets/**/*",
      "package.json"
    ],
    "asar": false,
    "protocols": [
      {
        "name": "Laki",
        "schemes": [
          "laki"
        ]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": "dir",
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "hardenedRuntime": false
    },
    "linux": {
      "target": "AppImage",
      "category": "Development",
      "executableName": "laki",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}
