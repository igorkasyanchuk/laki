{
  "name": "My PRs",
  "description": "Your open pull requests in a repo (or someone's): how many, drafts, conflicts and up to 3 labels you count; a click groups them: conflicts, failing CI, changes asked, approved, in review, drafts.",
  "size": [
    3,
    1
  ],
  "every": 5,
  "view": "l",
  "config": {
    "repo": {
      "label": "Repo",
      "hint": "owner/name, or its GitHub link"
    },
    "author": {
      "label": "Author",
      "hint": "a GitHub login; empty: you",
      "default": "@me"
    },
    "label1": {
      "label": "Count label 1",
      "hint": "e.g. bug"
    },
    "label2": {
      "label": "Count label 2",
      "hint": "e.g. needs-review"
    },
    "label3": {
      "label": "Count label 3",
      "hint": "e.g. p1"
    },
    "only": {
      "type": "list",
      "label": "Only with labels",
      "hint": "any of these; empty: all"
    },
    "hide": {
      "type": "list",
      "label": "Hide with labels",
      "hint": "e.g. wip, do-not-merge"
    }
  },
  "fetch": "sh fetch.sh",
  "ui": {
    "preview": {
      "type": "stack",
      "children": [
        {
          "type": "stats",
          "each": "data.stats",
          "value": "{{n}}",
          "label": "{{name}}",
          "color": "{{color}}",
          "tone": "{{#if bad}}bad{{/if}}",
          "tip": "{{n}} {{name}}",
          "if": "data"
        },
        {
          "type": "stat",
          "unless": "data",
          "value": "–",
          "label": "my PRs",
          "tone": "muted"
        }
      ]
    },
    "full": {
      "type": "stack",
      "children": [
        {
          "type": "stats",
          "each": "data.stats",
          "value": "{{n}}",
          "label": "{{name}}",
          "color": "{{color}}",
          "tone": "{{#if bad}}bad{{/if}}",
          "tip": "{{n}} {{name}}",
          "if": "data"
        },
        {
          "type": "text",
          "if": "data",
          "size": "sm",
          "muted": true,
          "value": "{{config.repo}} · by {{#if config.author}}{{config.author}}{{else}}@me{{/if}}{{#if at}} · checked {{ago at}}{{/if}}"
        },
        {
          "type": "section",
          "each": "data.groups",
          "title": "{{name}}",
          "subtitle": "{{prs.length}}",
          "children": [
            {
              "type": "list",
              "each": "prs",
              "title": "#{{number}} {{title}}",
              "subtitle": "{{author}} · opened {{date createdAt}}",
              "avatar": "{{author}}",
              "href": "{{url}}",
              "accessories": [
                {
                  "tag": "{{#if draft}}{{#if conflict}}conflict{{/if}}{{/if}}",
                  "tone": "bad"
                },
                {
                  "each": "labels",
                  "tag": "{{name}}",
                  "color": "{{color}}"
                },
                {
                  "text": "{{ci}}",
                  "tone": {
                    "failing": "bad",
                    "passing": "good",
                    "pending": "warn"
                  }
                },
                {
                  "text": "{{#if approved}}✓ approved{{else}}{{#if changes}}changes asked{{else}}waiting{{/if}}{{/if}}",
                  "tone": {
                    "✓ approved": "good",
                    "changes asked": "bad",
                    "waiting": "muted"
                  }
                }
              ],
              "actions": [
                {
                  "label": "Open",
                  "open": "{{url}}"
                }
              ]
            }
          ]
        },
        {
          "type": "empty",
          "if": "data",
          "unless": "data.groups",
          "text": "No open PRs."
        },
        {
          "type": "text",
          "unless": "data",
          "muted": true,
          "wrap": true,
          "value": "{{#if error}}{{error}}{{else}}Not fetched yet.{{/if}}"
        }
      ]
    }
  },
