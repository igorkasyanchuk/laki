#!/bin/sh
# fake macOS security: Claude Code's Keychain item is $HOME/keychain when there (tests never read the real Keychain)
echo "security $*" >> "${FAKE_LOG:-/dev/null}"
[ "$1" = find-generic-password ] && [ -f "$HOME/keychain" ] && { cat "$HOME/keychain"; exit 0; }
echo "security: SecKeychainSearchCopyNext: The specified item could not be found in the keychain." >&2
exit 44
