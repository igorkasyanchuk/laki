#!/usr/bin/env node
// fake codex: records its args; each Enter ends a turn by running the notify program from -c notify=[…]
const fs = require('fs'), { execFileSync } = require('child_process')
const args = process.argv.slice(2)
fs.appendFileSync(process.env.FAKE_LOG || '/dev/null', JSON.stringify({ bin: 'codex', tab: process.env.WB_TAB, args }) + '\n')
const n = args.find(a => a.startsWith('notify='))
const notify = n ? JSON.parse(n.slice(7)) : null
const thread = args[0] === 'resume' ? args[1] : 'thread-' + Math.random().toString(36).slice(2, 8)
process.stdout.write('\x1b[?2004hfake codex\r\n> ')
let line = ''
process.stdin.setRawMode(true)
process.stdin.on('data', d => {
  for (const ch of d.toString().replace(/\x1b\[20[01]~/g, '')) {
    if (ch === '\r') {
      const t = line; line = ''
      process.stdout.write(`\r\nanswer: ${t}\r\n${t.includes('limit') ? "■ You've hit your usage limit. Try again in 2 hours.\r\n" : ''}> `)
      if (notify) setTimeout(() => { try { execFileSync(notify[0], [...notify.slice(1), JSON.stringify({ type: 'agent-turn-complete', 'thread-id': thread, 'last-assistant-message': `answer: ${t}` })], { stdio: 'ignore' }) } catch {} }, 100)
    } else if (ch === '\x03') process.exit(130)
    else { line += ch; process.stdout.write(ch) }
  }
})
