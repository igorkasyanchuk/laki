#!/bin/bash
# fake ssh: every host is this machine. A command runs in sh with a host's env (none of the Mac's LAKI_ vars);
# -F: its config, logged (cfg); -M keeps a pretend ControlMaster (its pid in the -S file); -O check/exit/forward/cancel ask it. Host "nohost" refuses.
ctl= op= master= cfg=
while [ $# -gt 0 ]; do
  case $1 in
    -S) ctl=$2; shift 2 ;;
    -O) op=$2; shift 2 ;;
    -F) cfg=$2; shift 2 ;;
    -o|-L|-R|-p|-i|-l|-J|-W|-E|-b|-c|-D|-e|-m|-Q|-w) shift 2 ;;
    -M) master=1; shift ;;
    -*) shift ;;
    *) break ;;
  esac
done
host=$1
shift
printf '{"bin":"ssh","host":"%s","op":"%s","master":"%s","cfg":"%s"}\n' "$host" "$op" "$master" "$cfg" >> "${FAKE_LOG:-/dev/null}"
if [ "$host" = nohost ]; then echo "ssh: connect to host nohost port 22: Connection refused" >&2; exit 255; fi
if [ -n "$op" ]; then
  pid=$(cat "$ctl" 2>/dev/null)
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    [ "$op" = exit ] && { kill "$pid"; rm -f "$ctl"; }
    exit 0
  fi
  echo "Control socket connect($ctl): No such file or directory" >&2
  exit 255
fi
if [ -n "$master" ]; then
  echo $$ > "$ctl"
  trap 'rm -f "$ctl"; exit 0' TERM HUP INT
  while kill -0 $PPID 2>/dev/null; do sleep 1 & wait $!; done # its daemon gone (killed hard): so is it
  rm -f "$ctl"
  exit 0
fi
for v in $(env | sed -nE 's/^(LAKI_[A-Za-z0-9_]*|PORT|TERM_PROGRAM|COLORTERM|OPENCODE_CONFIG_DIR|GEMINI_CLI_SYSTEM_DEFAULTS_PATH|TEST_[A-Za-z0-9_]*)=.*/\1/p'); do unset "$v"; done
exec /bin/sh -c "$*"
