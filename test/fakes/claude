#!/usr/bin/env node
// fake claude: records its args, reports states through the hook commands in --settings, echoes input
const fs = require('fs'), { execSync } = require('child_process')
const args = process.argv.slice(2)
fs.appendFileSync(process.env.FAKE_LOG || '/dev/null', JSON.stringify({ bin: 'claude', tab: process.env.LAKI_TAB, port: process.env.PORT, storage: process.env.LAKI_STORAGE_FOLDER, args, env: Object.fromEntries(Object.entries(process.env).filter(([k]) => k.startsWith('TEST_') || k === 'LAKI_PROGRESS' || k === 'CLAUDE_CONFIG_DIR')) }) + '\n')
// -p (Laki's AI): stream-json, one laki_state call through the --mcp-config server; "fail…" fails, "slow…" waits;
// a brainstorm writes its ideas.md
// -p --output-format json (an extension's AI source, aiOnce): one result; "fail…" fails, "words…" has no json block
if (args[0] === '-p' && args[args.indexOf('--output-format') + 1] === 'json') {
  const prompt = args[args.length - 1]
  const tools = args.includes('--allowedTools') ? args[args.indexOf('--allowedTools') + 1] : ''
  const done = result => process.stdout.write(JSON.stringify({ type: 'result', subtype: 'success', is_error: false, result, total_cost_usd: 0.002, usage: { input_tokens: 10, output_tokens: 5 } }))
  if (prompt.startsWith('fail')) return process.stdout.write(JSON.stringify({ type: 'result', subtype: 'error_during_execution', is_error: true, result: 'it broke' })), (process.exitCode = 1)
  if (prompt.startsWith('words')) return done(`Just words: ${prompt}`)
  if (prompt.startsWith('data')) return done('Done.\n\n```json\n{"data": {"n": 9}}\n```')
  if (prompt.startsWith('toast')) return done('```json\n{"toast": "sent"}\n```')
  return done(`Found it.\n\n\`\`\`json\n{"text": "draft"}\n\`\`\`\n\nThe data:\n\n\`\`\`json\n${JSON.stringify({ text: prompt, tools, account: process.env.TEST_ACCOUNT ?? '' })}\n\`\`\`\n`)
}
if (args[0] === '-p') {
  const out = o => process.stdout.write(JSON.stringify(o) + '\n')
  const prompt = args[args.length - 1]
  const session = args.includes('--resume') ? args[args.indexOf('--resume') + 1] : 'sess-p1'
  out({ type: 'system', subtype: 'init', session_id: session, model: 'fake-sonnet' })
  if (prompt.startsWith('fail')) return out({ type: 'result', subtype: 'error_during_execution', is_error: true, result: 'it broke', session_id: session }), (process.exitCode = 1) // as the real one: its error, then 1
  if (prompt.startsWith('slow')) return setTimeout(() => {}, 60000)
  // a brainstorm (the Specs page's): its ideas written into the brainstorm, as the prompt names it
  const b = prompt.startsWith('Brainstorm session') && /laki_plan_read \(project (\S+), kind brainstorm, slug (\S+)\)/.exec(prompt)
  if (b) return require('./mcp.cjs')(JSON.parse(args[args.indexOf('--mcp-config') + 1]).mcpServers.laki, 'laki_plan_write', { project: b[1], kind: 'brainstorm', slug: b[2], path: 'ideas.md', text: '# Two options' }).then(text =>
    out({ type: 'result', subtype: 'success', is_error: false, result: `wrote ${JSON.parse(text).path}`, session_id: session, total_cost_usd: 0.01, usage: { input_tokens: 1, output_tokens: 1 } }))
  out({ type: 'assistant', message: { content: [{ type: 'tool_use', name: 'mcp__laki__laki_state', input: {} }] } })
  return require('./mcp.cjs')(JSON.parse(args[args.indexOf('--mcp-config') + 1]).mcpServers.laki, 'laki_state', {}).then(text => {
    out({ type: 'user', message: { content: [{ type: 'tool_result', content: text }] } })
    const r = `${JSON.parse(text).workspaces.length} workspaces, asked: ${prompt}`
    out({ type: 'result', subtype: 'success', is_error: false, result: r, session_id: session, total_cost_usd: 0.0123, usage: { input_tokens: 100, cache_read_input_tokens: 50, output_tokens: 20 } })
  })
}
const settings = JSON.parse(fs.readFileSync(args[args.indexOf('--settings') + 1], 'utf8'))
const hook = (ev, payload) => {
  const cmd = settings.hooks[ev][0].hooks[0].command
  try { execSync(cmd, { input: JSON.stringify(payload), stdio: ['pipe', 'ignore', 'inherit'], timeout: 3000 }) } catch {}
}
const ri = args.indexOf('--resume')
const session = ri >= 0 && !args.includes('--fork-session') ? args[ri + 1] : 'sess-' + Math.random().toString(36).slice(2, 8)
if (session.startsWith('gone-')) {
  process.stdout.write(`No conversation found with session ID: ${session}\r\n`)
  process.exit(1)
}
process.stdout.write('\x1b[?2004h') // bracketed paste on, like the real one
process.stdout.write(`fake claude ${args.filter(a => !a.includes('/')).join(' ')}\r\n`)
hook('SessionStart', { session_id: session })
let busy = false // a turn under way: Esc interrupts it (no Stop hook, like the real one)
// "menu": a permission prompt like the real one's, ↑↓ move its ❯, Enter picks
const MENU = ['Yes', "Yes, and don't ask again for rm commands", 'No, and tell Claude what to do differently (esc)']
let menu = 0
const drawMenu = () => process.stdout.write(MENU.map((m, i) => `\x1b[2K${i + 1 === menu ? '❯' : ' '} ${i + 1}. ${m}`).join('\r\n') + '\r\n')
const turn = text => {
  hook('UserPromptSubmit', { prompt: text })
  if (text.startsWith('menu')) { process.stdout.write('Bash command\r\n\r\n  rm -rf build\r\n\r\nDo you want to proceed?\r\n'); menu = 1; drawMenu(); hook('Notification', { message: 'Claude needs your permission to use Bash' }); return }
  if (text.startsWith('ask')) { process.stdout.write('allow? (y/n)\r\n'); hook('Notification', { message: 'needs permission' }); return }
  busy = true
  if (text.startsWith('slow')) return void process.stdout.write('✻ Working… (esc to interrupt)\r\n') // until Esc
  if (text.startsWith('mute')) return // a turn that ends without a hook or a word (a resumed chat's recap)
  setTimeout(() => {
    if (!busy) return
    busy = false
    process.stdout.write(`answer: ${text}\r\n> `)
    hook('Stop', { last_assistant_message: `answer: ${text}` })
  }, Number(process.env.FAKE_TURN_MS || 300))
}
const positional = args.filter((a, i) => !a.startsWith('--') && !['--settings', '--resume', '--model', '--plugin-dir', '--append-system-prompt'].includes(args[i - 1]))
process.stdin.setRawMode(true) // before the first turn's hooks (execSync blocks): a key typed meanwhile stays raw
if (positional.length) turn(positional.at(-1))
else process.stdout.write('> ')
let line = ''
process.stdin.on('data', d => {
  const s = d.toString().replace(/\x1b\[20[01]~/g, '')
  if (menu) {
    const keys = s.match(/\x1b[[O][AB]|\r/g) // each key, in order: a busy machine hands keys sent 40 ms apart over in one read
    if (!keys) return
    for (const k of keys) {
      if (k === '\r') {
        const pick = MENU[menu - 1]
        menu = 0
        process.stdout.write(`picked: ${pick}\r\n> `)
        return hook('Stop', { last_assistant_message: `picked: ${pick}` })
      }
      menu = k.endsWith('B') ? Math.min(MENU.length, menu + 1) : Math.max(1, menu - 1)
    }
    process.stdout.write(`\x1b[${MENU.length}A\r`)
    return drawMenu()
  }
  for (const ch of s) {
    if (ch === '\r') { process.stdout.write('\r\n'); const t = line; line = ''; if (t === 'exit') process.exit(0); turn(t) }
    else if (ch === '\x03') process.exit(130)
    else if (ch === '\x1b' && busy) { busy = false; process.stdout.write('\r\n  ⎿  Interrupted · What should Claude do instead?\r\n> ') }
    else { line += ch; process.stdout.write(ch) }
  }
})
