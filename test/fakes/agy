#!/usr/bin/env node
// fake agy (Antigravity CLI, the gemini agent): records its args, no hooks: says what it does over OSC 7501 once the
// terminal answers its query (as agy does), shows "esc to cancel" while it works; "ask…" blocks on a permission menu
// until 1; a /command takes no turn (no report); on exit prints its resume line, agy --conversation=<id>
const fs = require('fs')
const args = process.argv.slice(2)
fs.appendFileSync(process.env.FAKE_LOG || '/dev/null', JSON.stringify({ bin: 'agy', tab: process.env.LAKI_TAB, args, ...(process.env.HTTPS_PROXY && { proxy: process.env.HTTPS_PROXY }), ...(process.env.AGY_CLI_DISABLE_AUTO_UPDATE && { noUpdate: process.env.AGY_CLI_DISABLE_AUTO_UPDATE }) }) + '\n')
// usage.ts' plan limits: --version (FAKE_AGY_VERSION), then -p /usage's print envelope (FAKE_AGY_USAGE: a JSON line of its own)
if (args[0] === '--version') (process.stdout.write(`${process.env.FAKE_AGY_VERSION || '1.5.14'}\n`), process.exit(0))
if (args[0] === '-p' && args[1] === '/usage') {
  const groups = [{ name: 'Gemini Models', buckets: [{ id: 'gemini-weekly', name: 'Weekly Limit Remaining', window: 'weekly', remaining_fraction: 0.75, reset_time: '2099-01-08T00:00:00Z' }, { id: 'gemini-5h', name: 'Five Hour Limit Remaining', window: '5h', remaining_fraction: 0.4, reset_time: '2099-01-01T05:00:00Z' }] }]
  process.stdout.write('agy: a log line first\n' + (process.env.FAKE_AGY_USAGE || JSON.stringify({ conversation_id: '', status: 'SUCCESS', num_turns: 0, command: { name: 'usage', data: { groups } } })) + '\n')
  process.exit(0)
}
const conv = (args.find(a => a.startsWith('--conversation=')) ?? '').slice(15) || (args.includes('-c') ? 'agy-latest' : 'agy-' + Math.random().toString(36).slice(2, 8))
let osc = false
const say = st => osc && process.stdout.write(`\x1b]7501;state=${st}\x07`)
let asking = ''
const turn = all => {
  const t = all.includes('\n```\n\n') ? all.slice(all.lastIndexOf('\n```\n\n') + 6) : all // Laki's fenced note first (core.ts memoryFirst): the task is after it
  if (t.startsWith('/')) return void process.stdout.write(`${t}: done here, no turn\r\n> `) // a command of its own: no OSC 7501
  say('working')
  process.stdout.write('⠋ Thinking... (esc to cancel)\r\n')
  if (t.startsWith('ask')) return void setTimeout(() => ((asking = t), say('blocked:kind=permission'), process.stdout.write('Allow this command?\r\n❯ 1. Allow once\r\n  2. Deny\r\n')), 200)
  if (t.startsWith('fail')) return void setTimeout(() => (process.stdout.write('Error: the model is overloaded\r\n> '), say('error')), 300)
  setTimeout(() => (process.stdout.write(`answer: ${t}\r\n> `), say('done')), 300)
}
const bye = code => (process.stdout.write(`\r\nResume with -c (or command below): agy --conversation=${conv}\r\n`), process.exit(code))
process.stdin.setRawMode(true) // before its banner: keys sent once it shows are read raw (cooked, a \r would be a \n)
process.stdout.write(`\x1b[?2004hfake agy ${args.join(' ')}\r\n`)
let line = ''
let started = false
const start = () => {
  if (started) return
  started = true
  const i = args.indexOf('-i')
  if (i >= 0) turn(args[i + 1])
  else (process.stdout.write('> '), say('idle'))
}
process.stdout.write('\x1b]7501;?\x07') // does the terminal speak it? (agy asks first)
const wait = setTimeout(start, 1000)
process.stdin.on('data', d => {
  let str = d.toString()
  const reply = /\x1b\]7501;\?:states=[^\x07\x1b]*(\x07|\x1b\\)/.exec(str)
  if (reply) (str = str.replace(reply[0], ''), (osc = true), clearTimeout(wait), start())
  for (const ch of str.replace(/\x1b\[20[01]~/g, '')) {
    if (ch === '\r') {
      process.stdout.write('\r\n')
      const t = line
      line = ''
      if (t === 'exit' || t === '/quit') bye(0)
      if (asking) { const a = asking; asking = ''; turn(t === '1' ? `allowed ${a}` : `denied ${a}`) }
      else turn(t)
    } else if (ch === '\x03') bye(130)
    else { line += ch; process.stdout.write(ch) }
  }
})
